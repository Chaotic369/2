{
  "manifest_version": 3,
  "name": "2",
  "version": "1.0.0",
  "description": "2 - Sovereign IDE Extension",
  "permissions": [
    "sidePanel",
    "windows",
    "tabs",
    "storage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "2"
  },
  "side_panel": {
    "default_path": "index.html"
  },
  "icons": {
    "512": "build-icon.png"
  }
}